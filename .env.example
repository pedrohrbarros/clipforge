GROQ_API_KEY=
# Google OAuth web client id; the API accepts Google ID tokens issued for it
GOOGLE_CLIENT_ID=
# Supabase: Postgres "session pooler" connection string (IPv4), project URL, service_role key
DATABASE_CONNECTION_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=shorts
# Resend for the "shorts are ready" email; EMAIL_FROM must be on a verified domain
RESEND_API_KEY=
EMAIL_FROM=ClipForge <shorts@yourdomain.com>
# Public URL of the web app, used in emails (defaults to the first allowed origin)
# APP_URL=https://clipforge-ui.vercel.app
# DAILY_LIMIT=3
# RETENTION_HOURS=24
ALLOWED_ORIGINS=http://localhost:3000
# optional
# MAX_UPLOAD_MB=500
# MAX_VIDEO_SECONDS=600
# JOB_TTL_SECONDS=3600
# WHISPER_MODEL=whisper-large-v3-turbo
# CHAT_MODEL=openai/gpt-oss-120b
# CHAT_REASONING_EFFORT=low
# CHAT_MAX_TOKENS=4096
